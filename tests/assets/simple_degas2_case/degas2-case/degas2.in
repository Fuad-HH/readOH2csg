# .nc "output" files read by other executables. 
# Can name the following however you want
problemfile problem.nc
geometryfile geometry.nc
backgroundfile background.nc
tallyfile tally.nc
outputfile output.nc

# Problem specific files. Generate these yourself.
problem_infile problem.in
tally_infile tally.in


