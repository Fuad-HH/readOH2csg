@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Omega_h 11.4.0 CONFIG HINTS @Omega_h_DIR@)
# the static libraries also need pugixml and netcdf-c at link time
find_dependency(pugixml CONFIG)
find_dependency(PkgConfig)
pkg_check_modules(OMEGAH2CSG_NETCDF REQUIRED IMPORTED_TARGET netcdf)
link_libraries(pugixml::pugixml PkgConfig::OMEGAH2CSG_NETCDF)

include("${CMAKE_CURRENT_LIST_DIR}/omegah2csg-targets.cmake")

check_required_components(omegah2csg)
